# ============================================================
# Cherry-Studio-BB .gitignore
# 忽略非源码文件、环境依赖、编译产物与本地临时数据，保持仓库干净
# ============================================================

# ---------- 依赖 ----------
node_modules/
.pnpm-store/
.yarn-cache/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.pnp.loader.mjs

# ---------- 构建与打包产物 ----------
dist/
out/
release/
build-output/
app-builds/
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm
*.zip
*.tar.gz
*.7z
stats.html

# ---------- 缓存与临时文件 ----------
.cache/
.vite/
.turbo/
.swc/
.eslintcache
.tsbuildinfo/
.context/
*.tsbuildinfo
*.tmp
*.temp
*.swp
*.swo
*~

# ---------- 日志 ----------
logs/
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 环境变量与敏感密钥（保留 .env.example 模板） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_ed25519
credentials.json
secrets.json

# ---------- 测试产物与报告 ----------
coverage/
.nyc_output/
.vitest-cache/
vitest.config.*.timestamp-*
playwright-report/
test-results/
tests/e2e/.artifacts/

# ---------- 编辑器与 IDE 配置 ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/launch.json.example
.idea/
*.iws
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vim/

# ---------- 本地 AI / 智能体工具缓存与配置 ----------
.reasonix/
.aider*
.cursor/
.cursorrules
.claude/*
!.claude/skills/
!.claude/skills/**
.gemini/*
.qwen/*
.trae/*
.cline/
.roo/
.windsurf/
.windsurfrules
.continue/
.void/
.copilot/
.claude-code-router/*
.codebuddy/*
.antigravitycli/*
.zed/*
!.zed/settings.json.example
CLAUDE.local.md
AGENTS.override.md
subagent/

# ---------- 本地数据与运行时目录 ----------
local/
local_*/
mcp_server/
resources/binaries/
.sessions/
ui-shots/
# WorkBuddy / 本地助手运行数据（内存日志、临时产物等，不入库）
.workbuddy/
.xx/
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal

# ---------- 操作系统临时文件 ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
.directory
*.local
